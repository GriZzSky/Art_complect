# Python
__pycache__/
*.pyc

# Runtime data бэкенда (логи, локи, архивы фидов, временные импорты)
ART_COMPL-BACKEND/data/logs/*.log
ART_COMPL-BACKEND/data/sync/*.lock
ART_COMPL-BACKEND/data/processed_feeds/**/*.xml
ART_COMPL-BACKEND/data/imports/*

# Постоянное хранилище фото товаров: накапливается из выгрузок 1С,
# десятки мегабайт, живёт только на сервере.
ART_COMPL-BACKEND/data/product_images/

# Выгрузка 1С (CommerceML): ~159 МБ, поступает регулярно.
# На сервер заливается отдельно (rsync/scp), в git не хранится.
/webdata/

# OS
Thumbs.db
.DS_Store

# Боевые секреты (пароль FTP, email Let's Encrypt) — только на сервере.
# Шаблон deploy/.env.prod.example в git остаётся, сам файл — нет.
deploy/.env.prod
