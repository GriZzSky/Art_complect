LETSENCRYPT_EMAIL=admin@art-komplekt.shop

# Публичный IP VPS — нужен FTP-серверу для пассивного режима.
SERVER_PUBLIC_IP=

# Учётка, которую отдаём магазину для выгрузки 1С (наш FTP-сервер).
# Не путать с FTP_* у сервиса api — то настройки исходящего FTP-клиента.
# Пароль сгенерировать на сервере ТОЛЬКО из букв и цифр:
#   tr -dc 'A-Za-z0-9' < /dev/urandom | head -c 24; echo
# Символ | разделяет поля в USERS, пробел разделяет учётки — в пароле их быть не должно.
FTP_SERVER_LOGIN=1c_upload
FTP_SERVER_PASSWORD=
